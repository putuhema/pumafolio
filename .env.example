


# Set the key for the provider you picked. Keys stay on the server.
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Public origin, no trailing slash. Used for canonical and Open Graph URLs.
# TODO: portfolio URL — set this once the site has a domain.
# VERCEL_URL and RAILWAY_PUBLIC_DOMAIN are used when this is empty.
NEXT_PUBLIC_SITE_URL=

# Cost guards. Defaults shown.
CHAT_MAX_INPUT_CHARS=500
CHAT_MAX_OUTPUT_TOKENS=400
CHAT_HISTORY_MESSAGES=6
CHAT_RATE_LIMIT=10
CHAT_RATE_WINDOW_MS=3600000

# Canned-answer pacing (milliseconds). Set both to 0 in tests.
CHAT_THINK_DELAY_MS=280
CHAT_TOKEN_DELAY_MS=18
